{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "__REPO_RELATED__": "____________________",
    "clean": "rm -rf .next coverage",
    "clean:mods": "rm -rf node_modules",
    "__ACTION_RELATED__": "__________________",
    "build:prod": "cp ./env/prod .env && next build",
    "build:ci": "cp ./env/ci .env && next build",
    "dev": "cp ./env/dev .env && next dev --turbo",
    "start": "next build && next start",
    "__TEST_RELATED__": "__________________",
    "lint": "next lint --no-cache",
    "__DATABASE_RELATED__": "",
    "db:gen": "drizzle-kit generate --config  ./src/db/config.ts",
    "db:sync": "DB_MIGRATING=true node -r esbuild-register ./src/db/migrate.ts",
    "db:seed": "DB_SEEDING=true node -r esbuild-register ./src/db/seeds/seed.ts",
    "db:show": "drizzle-kit studio --config  ./src/db/config.ts --port 5555"
  },
  "dependencies": {
    "next": "14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
