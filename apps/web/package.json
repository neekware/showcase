{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "__REPO_RELATED__": "",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf .next && rm -rf coverage",
    "clean:mods": "rm -rf node_modules",
    "__FORMAT_RELATED__": "",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "__ACTION_RELATED__": "",
    "build:main": "cp ./env/main .env && next build",
    "build:ci": "cp ./env/ci .env && next build",
    "build": "cp ./env/dev .env && next build",
    "dev": "cp ./env/dev .env && next dev -p 4200 -H 0.0.0.0",
    "start": "next start -p 3200 -H 0.0.0.0",
    "test": "jest --coverage --passWithNoTests",
    "__DATABASE_RELATED__": "",
    "web:db:gen": "drizzle-kit generate --config  ./src/db/config.ts",
    "web:db:sync": "DB_MIGRATING=true node -r esbuild-register ./src/db/migrate.ts",
    "web:db:seed": "DB_SEEDING=true node -r esbuild-register ./src/db/seeds/seed.ts",
    "web:db:show": "drizzle-kit studio --config  ./src/db/config.ts --port 5555"
  },
  "jest": {
    "preset": "@repo/jest-presets/browser"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@repo/ag-db": "workspace:*",
    "@repo/ag-dto": "workspace:*",
    "@repo/ag-logger": "workspace:*",
    "@repo/ag-user": "workspace:*",
    "@repo/ag-util": "workspace:*",
    "@repo/nx-auth": "workspace:*",
    "@repo/nx-ui": "workspace:*",
    "@repo/nx-ui-form": "workspace:*",
    "@repo/nx-ui-vendor": "workspace:*",
    "@repo/nx-util": "workspace:*",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "drizzle-orm": "^0.31.0",
    "jotai": "^2.8.2",
    "next": "15.0.0-rc.0",
    "postgres": "^3.4.4",
    "react": "19.0.0-rc-6d3110b4d9-20240531",
    "react-dom": "19.0.0-rc-6d3110b4d9-20240531",
    "react-hook-form": "^7.51.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.13.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "cssnano": "^7.0.1",
    "drizzle-kit": "^0.22.1",
    "esbuild-register": "^3.5.0",
    "jest": "^29.7.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5"
  }
}
