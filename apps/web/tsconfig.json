{
  "exclude": ["node_modules"],
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "src",
    "postcss.config.js",
    "tailwind.config.ts",
    "next.config.js",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/env/**/*.ts",
    "sdrizzle.config.ts"
  ]
}
