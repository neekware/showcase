{
  "exclude": ["node_modules"],
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@web/auth": ["./auth.ts"],
      "@web/cfg": ["src/cfg/index.ts"],
      "@web/app/*": ["src/app/*"],
      "@web/hooks/*": ["src/hooks/*"],
      "@web/styles/*": ["src/styles/*"]
    }
  },
  "include": [
    "src",
    "postcss.config.js",
    "tailwind.config.ts",
    "next.config.js",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ]
}
