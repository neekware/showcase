{
  "exclude": ["node_modules"],
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@web/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "postcss.config.js",
    "tailwind.config.js",
    "next.config.js",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ]
}
