{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2015"],
    "outDir": "./dist",
    "types": ["jest", "node"],
    "module": "CommonJS",
    "noEmit": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es6"
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
