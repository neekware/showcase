    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "tsup": "^8.0.2",
    "@turbo/gen": "^1.13.2",
    "@types/eslint": "^8.56.10",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "eslint": "^8.57.0",
    "react": "^18.2.0",
    "typescript": "^5.4.5"
  }
