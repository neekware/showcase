    "@repo/typescript-config": "workspace:*",
    "@types/eslint": "^8.56.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@repo/dto": "workspace:*",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  }
