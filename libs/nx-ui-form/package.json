{
  "name": "@repo/nx-ui-form",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "__REPO_RELATED__": "",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf .next && rm -rf coverage",
    "clean:mods": "rm -rf node_modules",
    "__FORMAT_RELATED__": "",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "__ACTION_RELATED__": "",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "@repo/jest-presets/browser",
    "coverageDirectory": "../../coverage/ui",
    "collectCoverage": true
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@repo/ag-dto": "workspace:*",
    "@repo/nx-util": "workspace:*",
    "@repo/nx-auth": "workspace:*",
    "@repo/nx-ui-vendor": "workspace:*",
