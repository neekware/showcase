{
  "name": "@repo/util",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "__REPO_RELATED__": "",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf .next && rm -rf coverage",
    "clean:deep": "rm -rf node_modules",
    "__FORMAT_RELATED__": "",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "__ACTION_RELATED__": "",
    "build:pkg": "tsup",
    "dev:pkg": "tsup --watch",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "@repo/jest-presets/browser",
    "coverageDirectory": "../../coverage/util",
    "collectCoverage": true
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  }
}
