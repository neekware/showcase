{
  "name": "@repo/util",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "__REPO_RELATED__": "",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf .next && rm -rf coverage",
    "clean:mods": "rm -rf node_modules",
    "__FORMAT_RELATED__": "",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "__ACTION_RELATED__": "",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "@repo/jest-cfg/browser",
    "coverageDirectory": "../../coverage/util",
    "collectCoverage": true
  },
  "devDependencies": {
    "@repo/eslint-cfg": "workspace:*",
    "@repo/jest-cfg": "workspace:*",
    "@repo/typescript-cfg": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vercel/style-guide": "^6.0.0",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-turbo": "^1.13.3",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-tailwindcss": "^3.15.1",
    "jotai": "^2.8.0",
    "next": "^14.2.3",
    "tailwind-merge": "^2.3.0"
  }
}
