    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "crypto-js": "^4.2.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@repo/ag-dto": "workspace:*",
