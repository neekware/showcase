{
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:playwright/recommended",
    "prettier"
  ],
  "plugins": ["@typescript-eslint", "import", "only-warn", "testing-library", "playwright"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "../../tsconfig.json"
  },
  "globals": {
    "React": true,
    "JSX": true,
    "browser": true,
    "page": true,
    "context": true,
    "PlaywrightTestConfig": true
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": "../../tsconfig.json"
      }
    }
  },
  "ignorePatterns": [".*.js", ".*.mjs", ".*.cjs", "node_modules/", "dist/", "tmp/", "build/"],
  "rules": {
    "import/named": "warn",
    "no-unused-vars": "warn",
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "playwright/no-skipped-test": "warn",
    "playwright/no-focused-test": "warn",
    "playwright/max-nested-describe": ["warn", { "max": 2 }]
  }
}
