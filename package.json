{
  "private": true,
  "scripts": {
    "__REPO_RELATED__": "",
    "prepare": "husky install",
    "update": "pnpm update --latest -r",
    "clean": "turbo clean; rm -rf .turbo && rm -rf dist && rm -rf coverage",
    "clean:mods": "turbo clean:mods; rm -rf node_modules",
    "clean:cache": "rm -rf node_modules/.cache",
    "loc": "turbo loc",
    "__FORMAT_RELATED__": "",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,html,css,svg,yml,json,md}\"",
    "lint": "turbo lint",
    "typecheck": "turbo run typecheck",
    "__ACTION_RELATED__": "",
    "build:web": "turbo build:web",
    "build:libs": "turbo build:libs",
    "start:web": "turbo start",
    "dev:web": "turbo dev",
    "dev:turbo": "turbo dev",
    "test": "turbo run test",
    "coveralls": "turbo coveralls"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.0.1",
    "@softonus/prettier-plugin-whitespace-remover": "^1.0.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "turbo": "^1.13.3"
  },
  "engines": {
    "node": ">=18"
  }
}
