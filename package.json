{
  "name": "@show/source",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "// Repository": "This is a repository clean up section",
    "clean": "pnpm recursive run clean",
    "clean:out": "rm -rf .coverage && rm -rf .e2e",
    "clean:mod": "pnpm recursive run clean:mods",
    "reset:all": "pnpm clean && pnpm clean:out && pnpm clean:mod && pnpm i",
    "// Linting": "This is a linting section",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,html,css,svg,yml,json,md}\"",
    "// App / Lib": "This is a app/lib section",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm recursive run lint",
    "test": "pnpm recursive run test",
    "e2e": "pnpm recursive run e2e",
    "e2e:report": "pnpm recursive run e2e:report"
  },
  "dependencies": {},
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "husky": "^9.0.11",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.4"
}
