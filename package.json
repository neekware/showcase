{
  "name": "@showcase/ui",
  "private": true,
  "scripts": {
    "__REPO_RELATED__": "",
    "prepare": "husky",
    "update": "pnpm update --latest -r",
    "clean": "turbo clean; rm -rf .turbo && rm -rf dist && rm -rf coverage && rm -rf node_modules/.cache",
    "clean:mods": "turbo clean:mods; rm -rf node_modules",
    "loc": "turbo loc --filter @repo/tools-util --only",
    "__FORMAT_RELATED__": "",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,html,css,svg,yml,json,md}\"",
    "lint": "turbo lint",
    "typecheck": "turbo run typecheck",
    "__ACTION_RELATED__": "",
    "build:main": "turbo build:main",
    "build:ci": "turbo build:ci",
    "build:dev": "turbo build:dev",
    "build": "turbo build",
    "start": "turbo start",
    "dev": "turbo dev --concurrency=20",
    "test": "turbo run test",
    "coveralls": "turbo coveralls",
    "__DATABASE_RELATED__": "",
    "web:db:gen": "turbo web:db:gen",
    "web:db:sync": "turbo web:db:sync",
    "web:db:seed": "turbo web:db:seed",
    "web:db:show": "turbo web:db:show"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "drizzle-kit": "^0.22.2",
    "husky": "^9.0.11",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "turbo": "2.0.2-canary.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.4"
}
