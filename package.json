{
  "name": "@show/source",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "__REPO_RELATED__": "____________________",
    "prepare": "husky install",
    "loc": "pnpm --filter infra loc",
    "update": "pnpm update --latest -r",
    "clean": "pnpm -r run clean",
    "clean:out": "rm -rf ./tmp/coverage && rm -rf .e2e",
    "clean:mod": "pnpm -r run clean:mods",
    "reset:all": "pnpm clean && pnpm clean:out && pnpm clean:mod && pnpm i",
    "__FORMAT_RELATED__": "__________________",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,html,css,svg,yml,json,md}\"",
    "lint": "pnpm -r run lint",
    "__ACTION_RELATED__": "__________________",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "__TEST_RELATED__": "__________________",
    "coverall": "find ./tmp/coverage -name lcov.info -exec cat {} + > ./tmp/coverage/lcov.combo.info",
    "test": "pnpm -r run test && pnpm coverall",
    "e2e": "pnpm -r run e2e",
    "e2e:report": "pnpm -r run e2e:report"
  },
  "dependencies": {},
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "husky": "^9.0.11",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.4"
}
